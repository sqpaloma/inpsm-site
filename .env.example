# Formulário de contato (/api/contact). Configure UMA das opções abaixo no Vercel
# (Project → Settings → Environment Variables) ou em .env.local para testes.

# Destinatário (padrão: contato@inpsm.com)
CONTACT_TO=contato@inpsm.com

# Remetente. Precisa ser um endereço autorizado pelo provedor escolhido
# (domínio verificado no Resend, ou a própria caixa do Microsoft 365 no SMTP).
CONTACT_FROM="Site IN Process Safety <site@inpsm.com>"

# Opção A — Resend (https://resend.com): verificar o domínio inpsm.com (registros DNS no Cloudflare)
RESEND_API_KEY=

# Opção B — SMTP (ex.: Microsoft 365). A caixa precisa ter "SMTP AUTH" habilitado no admin do M365.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
